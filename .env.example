# Postgres (Coolify). With docker-compose these are wired automatically.
POSTGRES_USER=ruwata
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ruwata
# Use your Coolify Postgres "internal URL" if the database is a separate Coolify resource.
DATABASE_URL=postgres://ruwata:change-me@postgres:5432/ruwata
DATABASE_SSL=false
